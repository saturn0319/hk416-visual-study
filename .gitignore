# Track portfolio documentation, feedback forms and static exterior images.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE.md
!/NOTICE.md
!/CONTRIBUTING.md
!/docs/
!/.github/

/docs/*
!/docs/*.md
!/docs/images/

/docs/images/*
!/docs/images/*.png
!/docs/images/*.jpg
!/docs/images/*.jpeg
!/docs/images/*.webp

/.github/*
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/*.yml
